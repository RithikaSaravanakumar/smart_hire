# ==============================================================================
# SmartHire Placement Portal — Environment Variables Template
# Copy this file to .env for local development or set in Railway Dashboard
# ==============================================================================

# Application Environment (production / development)
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Secret Keys (Replace with cryptographically secure random values)
SECRET_KEY=generate-a-strong-random-secret-key
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Connection
# Production (Railway MySQL): mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Local Dev fallback: sqlite:///smarthire.db
DATABASE_URL=mysql+pymysql://root:password@mysql.railway.internal:3306/railway

# Allowed Frontend Origins (Comma-separated for multiple domains, or * for all)
FRONTEND_URL=*

# Resume Upload Limits (5MB in bytes: 5242880)
MAX_RESUME_SIZE=5242880

# External Location API Configuration
EXTERNAL_API_URL=https://geocoding-api.open-meteo.com/v1/search
EXTERNAL_API_TIMEOUT=3
